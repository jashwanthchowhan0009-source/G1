# Brain: mock (offline demo) | gemini (free tier) | claude
G1_LLM=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

G1_OWNER_NAME=Jashwanth
G1_LANGUAGE=hinglish

# Optional: send WhatsApp from G1's own business number (else click-to-chat links)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional: nicer voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: post videos to YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Dev kit only: 4G modem AT port for SMS
G1_MODEM_PORT=/dev/ttyUSB2

# Required if G1 Core is reachable from other devices
G1_ACCESS_KEY=
